---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { accesorios } from '../data/instrumentos';

const { nombre, icono, descripcionLarga, productos, count, marcas } = accesorios
---

<Layout title={`${nombre} — Universo Musical`} description={`${descripcionLarga} Más de ${count} productos.`}>
  <nav class="catalog-nav">
    <div class="container">
      <a href="/#servicios" class="catalog-back">
        <span class="back-arrow">←</span>
        <span>Volver a servicios</span>
      </a>
      <a href="/" class="catalog-logo">UNIVERSO MUSICAL</a>
    </div>
  </nav>

  <section class="catalog-page">
    <div class="container">
      <header class="catalog-header">
        <div class="ch-icon">{icono}</div>
        <div>
          <h1 class="ch-title">{nombre}</h1>
          <p class="ch-desc">{descripcionLarga}</p>
          <div class="ch-meta">
            <span class="ch-count">{count} productos</span>
            <span class="ch-dot">•</span>
            <span class="ch-brands">{marcas.join(' · ')}</span>
          </div>
        </div>
      </header>

      <div class="catalog-grid">
        {productos.map(p => (
          <ProductCard
            nombre={p.nombre}
            marca={p.marca}
            precio={p.precio}
            descripcion={p.descripcion}
            icono={p.icono}
          />
        ))}
      </div>
    </div>
  </section>

  <footer class="catalog-footer">
    <div class="container">
      <a href="/#servicios" class="catalog-back centered">
        <span class="back-arrow">←</span>
        <span>Volver a servicios</span>
      </a>
    </div>
  </footer>
</Layout>
