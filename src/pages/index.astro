---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ========== NAVBAR ========== -->
  <header class="navbar" id="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo" id="navLogo">
        <span class="logo-icon">🎵</span>
        <span class="logo-text">UNIVERSO MUSICAL</span>
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="#instrumentos" class="nav-link" data-text="Instrumentos"
          >Instrumentos</a
        >
        <a href="#servicios" class="nav-link" data-text="Servicios">Servicios</a
        >
        <a href="#clases" class="nav-link" data-text="Clases">Clases</a>
        <a href="#eventos" class="nav-link" data-text="Eventos">Eventos</a>
        <a href="#galeria-clases" class="nav-link" data-text="Galería">Galería</a>
        <a href="#contacto" class="nav-link" data-text="Contacto">Contacto</a>
      </nav>
      <button
        class="hamburger"
        id="hamburger"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- ========== HERO SECTION ========== -->
  <section class="hero" id="home">
    <div class="hero-bg">
      <img
        src="/hero_bg.png"
        alt="Instrumentos musicales — Universo Musical Neiva"
        class="hero-bg-img"
        width="1920"
        height="1080"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge reveal-up">
        <span class="badge-dot"></span>
        <span>Desde 2024 · Más de 700 músicos satisfechos</span>
      </div>

      <h1 class="hero-title reveal-up delay-1">
        <span class="title-line">DONDE LA</span>
        <span class="title-line gradient-text">MÚSICA</span>
        <span class="title-line">COBRA VIDA</span>
      </h1>

      <p class="hero-desc reveal-up delay-2">
        Instrumentos, clases, sonidos digitales, accesorios y asesoría para
        eventos.<br />
        Todo lo que tu pasión musical necesita, en un solo lugar.
      </p>

      <div class="hero-cta reveal-up delay-3">
        <a href="#instrumentos" class="btn-primary btn-large">
          <span>Explorar Catálogo</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
        <a href="#clases" class="btn-ghost btn-large">
          <span>Ver Clases</span>
        </a>
      </div>

      <div class="hero-stats reveal-up delay-4">
        <div class="stat-item">
          <span class="stat-num" data-target="700">0</span><span
            class="stat-plus">+</span
          >
          <span class="stat-label">Instrumentos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="25">0</span><span
            class="stat-plus">+</span
          >
          <span class="stat-label">Instructores</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="4">0</span><span class="stat-plus"
            >+</span
          >
          <span class="stat-label">Años de Experiencia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="98">0</span><span
            class="stat-plus">%</span
          >
          <span class="stat-label">Satisfacción</span>
        </div>
      </div>
    </div>

    <div class="hero-badges reveal-up delay-4">
      <span class="hero-badge">🚚 Envíos a todo el país</span>
      <span class="hero-badge-sep">·</span>
      <span class="hero-badge">💰 Créditos y SisteCrédito</span>
    </div>

    <div class="hero-scroll-indicator">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>

    <!-- Floating musical notes -->
    <div class="floating-notes">
      <span class="fnote n1">♪</span>
      <span class="fnote n2">♫</span>
      <span class="fnote n3">♩</span>
      <span class="fnote n4">♬</span>
      <span class="fnote n5">♭</span>
      <span class="fnote n6">♮</span>
    </div>
  </section>

  <!-- ========== MARQUEE TICKER ========== -->
  <div class="marquee-section">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>🎸 Guitarras Eléctricas</span>
        <span class="sep">✦</span>
        <span>🎹 Pianos & Teclados</span>
        <span class="sep">✦</span>
        <span>🥁 Baterías</span>
        <span class="sep">✦</span>
        <span>🎷 Saxofones</span>
        <span class="sep">✦</span>
        <span>🎺 Trompetas</span>
        <span class="sep">✦</span>
        <span>🎻 Violines</span>
        <span class="sep">✦</span>
        <span>🎙️ Micrófonos Pro</span>
        <span class="sep">✦</span>
        <span>🎧 Sonidos Digitales</span>
        <span class="sep">✦</span>
        <span>📚 Clases Musicales</span>
        <span class="sep">✦</span>
        <span>🔊 Asesoría en Eventos</span>
        <span class="sep">✦</span>
        <span>🔧 Ensamble de Instrumentos</span>
        <span class="sep">✦</span>
        <span>🎸 Guitarras Eléctricas</span>
        <span class="sep">✦</span>
        <span>🎹 Pianos & Teclados</span>
        <span class="sep">✦</span>
        <span>🥁 Baterías</span>
        <span class="sep">✦</span>
        <span>🎷 Saxofones</span>
        <span class="sep">✦</span>
        <span>🎺 Trompetas</span>
        <span class="sep">✦</span>
        <span>🎻 Violines</span>
        <span class="sep">✦</span>
        <span>🎙️ Micrófonos Pro</span>
        <span class="sep">✦</span>
        <span>🎧 Sonidos Digitales</span>
        <span class="sep">✦</span>
        <span>📚 Clases Musicales</span>
        <span class="sep">✦</span>
        <span>🔊 Asesoría en Eventos</span>
        <span class="sep">✦</span>
        <span>🔧 Ensamble de Instrumentos</span>
        <span class="sep">✦</span>
      </div>
    </div>
  </div>

  <!-- ========== CATEGORÍAS / INSTRUMENTOS ========== -->
  <section class="instruments-section" id="instrumentos">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow reveal-up">Nuestro Catálogo</p>
        <h2 class="section-title reveal-up delay-1">
          Los Mejores <span class="gradient-text">Instrumentos</span>
        </h2>
        <p class="section-desc reveal-up delay-2">
          Desde guitarras eléctricas hasta instrumentos de viento, contamos con
          todo para el músico principiante y el profesional más exigente.
        </p>
      </div>

      <div class="instruments-grid">
        <a
          href="/instrumentos/guitarras/"
          class="instrument-card reveal-card"
          id="cat-guitar"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🎸</div>
          </div>
          <h3>Guitarras</h3>
          <p>
            Eléctricas, acústicas, clásicas y bajos. Las mejores marcas al mejor
            precio.
          </p>
          <div class="card-meta">
            <span class="card-count">+120 modelos</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Fender</span><span>Gibson</span><span>Yamaha</span>
          </div>
        </a>

        <a
          href="/instrumentos/pianos/"
          class="instrument-card reveal-card delay-1"
          id="cat-piano"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🎹</div>
          </div>
          <h3>Pianos & Teclados</h3>
          <p>
            Pianos digitales, teclados MIDI y sintetizadores para todo nivel.
          </p>
          <div class="card-meta">
            <span class="card-count">+85 modelos</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Roland</span><span>Korg</span><span>Casio</span>
          </div>
        </a>

        <a
          href="/instrumentos/percusion/"
          class="instrument-card reveal-card delay-2"
          id="cat-drums"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🥁</div>
          </div>
          <h3>Percusión</h3>
          <p>
            Baterías acústicas, electrónicas, congas, bongós y toda la percusión
            latina.
          </p>
          <div class="card-meta">
            <span class="card-count">+60 modelos</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Pearl</span><span>Tama</span><span>DW</span>
          </div>
        </a>

        <a
          href="/instrumentos/vientos/"
          class="instrument-card reveal-card delay-3"
          id="cat-wind"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🎷</div>
          </div>
          <h3>Vientos</h3>
          <p>
            Saxofones, trompetas, trombones, flautas y más instrumentos de
            viento.
          </p>
          <div class="card-meta">
            <span class="card-count">+45 modelos</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Selmer</span><span>Bach</span><span>Jupiter</span>
          </div>
        </a>

        <a
          href="/instrumentos/cuerdas-clasicas/"
          class="instrument-card reveal-card delay-4"
          id="cat-strings"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🎻</div>
          </div>
          <h3>Cuerdas Clásicas</h3>
          <p>
            Violines, violas, chelos y contrabajos para estudiantes y
            concertistas.
          </p>
          <div class="card-meta">
            <span class="card-count">+30 modelos</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Stentor</span><span>Cremona</span><span>D'Addario</span>
          </div>
        </a>

        <a
          href="/instrumentos/sonidos-digitales/"
          class="instrument-card reveal-card delay-5"
          id="cat-digital"
        >
          <div class="card-glow"></div>
          <div class="card-icon-wrap">
            <div class="card-icon">🎧</div>
          </div>
          <h3>Sonidos Digitales</h3>
          <p>
            Sample packs, plugins VST, loops y bancos de sonidos profesionales.
          </p>
          <div class="card-meta">
            <span class="card-count">+500 packs</span>
            <span class="card-link">Ver todo <span>→</span></span>
          </div>
          <div class="card-tags">
            <span>Splice</span><span>Native</span><span>Arturia</span>
          </div>
        </a>
      </div>

      <div class="instruments-showcase reveal-up">
        <img
          src="/instruments.png"
          alt="Catálogo de instrumentos musicales"
          class="showcase-img"
          width="1280"
          height="400"
          loading="lazy"
        />
        <div class="showcase-badge">
          <div class="badge-inner">
            <span class="badge-big">500+</span>
            <span class="badge-small">Productos disponibles</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICIOS ========== -->
  <section class="services-section" id="servicios">
    <div class="services-bg-text">SERVICIOS</div>
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow reveal-up">Lo que hacemos</p>
        <h2 class="section-title reveal-up delay-1">
          Servicios <span class="gradient-text">Premium</span>
        </h2>
      </div>

      <div class="services-grid">
        <div class="service-card reveal-card" id="svc-store">
          <div class="sc-number">01</div>
          <div class="sc-icon">🏪</div>
          <h3>Tienda Especializada</h3>
          <p>
            Más de 500 instrumentos, accesorios y equipos de las mejores marcas
            mundiales. Atención personalizada y garantía en todos los productos.
          </p>
          <ul class="sc-list">
            <li>✓ Garantía de 1 a 3 años</li>
            <li>✓ Financiamiento disponible</li>
            <li>✓ Asesoría gratuita</li>
          </ul>
          <a href="/#instrumentos" class="sc-cta">Explorar <span>↗</span></a>
        </div>

        <a
          href="/accesorios/"
          class="service-card reveal-card delay-1"
          id="svc-accessories"
        >
          <div class="sc-number">02</div>
          <div class="sc-icon">🎛️</div>
          <h3>Accesorios & Equipo</h3>
          <p>
            Cuerdas, baquetas, afinadores, pedales, amplificadores, cables,
            estuches y todo lo que necesitas.
          </p>
          <div class="sc-tags">
            <span>Cuerdas</span><span>Pedales</span><span>Amplificadores</span
            ><span>Estuches</span>
          </div>
          <span class="sc-cta">Ver Accesorios <span>↗</span></span>
        </a>

        <div class="service-card reveal-card delay-2" id="svc-sounds">
          <div class="sc-number">03</div>
          <div class="sc-icon">🔊</div>
          <h3>Asesoría para Eventos</h3>
          <p>
            Diseño de sistemas de sonido profesional para conciertos, bodas,
            eventos corporativos y más.
          </p>
          <div class="sc-tags">
            <span>Conciertos</span><span>Bodas</span><span>Corporativos</span
            ><span>Festivales</span>
          </div>
          <a href="/#eventos" class="sc-cta">Saber Más <span>↗</span></a>
        </div>

        <div class="service-card reveal-card delay-3" id="svc-assembly">
          <div class="sc-number">04</div>
          <div class="sc-icon">🔧</div>
          <h3>Ensamble de Instrumentos</h3>
          <p>
            Armado, configuración y personalización de instrumentos a la medida
            de tu estilo y necesidades.
          </p>
          <div class="sc-tags">
            <span>Guitarras</span><span>Bajos</span><span>Baterías</span><span
              >Personalización</span
            >
          </div>
          <a href="/#contacto" class="sc-cta">Consultar <span>↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLASES ========== -->
  <section class="classes-section" id="clases">
    <div class="container">
      <div class="classes-inner">
        <div class="classes-content">
          <p class="section-eyebrow reveal-up">Academia Musical</p>
          <h2 class="section-title reveal-up delay-1">
            Clases para <span class="gradient-text">Todos</span> los Niveles
          </h2>
          <p class="section-desc reveal-up delay-2">
            Aprende con los mejores instructores certificados. Clases
            individuales o grupales, presenciales y en línea. Desde el primer
            acorde hasta el escenario profesional.
          </p>

          <div class="classes-grid reveal-up delay-3">
            <div class="class-item" id="cls-guitar">
              <div class="class-icon">🎸</div>
              <div class="class-info">
                <strong>Guitarra</strong>
                <span>Eléctrica, Acústica & Clásica</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
            <div class="class-item" id="cls-piano">
              <div class="class-icon">🎹</div>
              <div class="class-info">
                <strong>Piano & Teclado</strong>
                <span>Desde básico hasta avanzado</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
            <div class="class-item" id="cls-drums">
              <div class="class-icon">🥁</div>
              <div class="class-info">
                <strong>Batería & Percusión</strong>
                <span>Rock, Jazz, Latina</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
            <div class="class-item" id="cls-bass">
              <div class="class-icon">🎵</div>
              <div class="class-info">
                <strong>Bajo Eléctrico</strong>
                <span>Técnica, groove y teoría</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
            <div class="class-item" id="cls-voice">
              <div class="class-icon">🎤</div>
              <div class="class-info">
                <strong>Canto & Voz</strong>
                <span>Técnica vocal y performance</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
            <div class="class-item" id="cls-theory">
              <div class="class-icon">📝</div>
              <div class="class-info">
                <strong>Teoría Musical</strong>
                <span>Solfeo, armonía y composición</span>
              </div>
              <div class="class-level">Todos los niveles</div>
            </div>
          </div>

          <div class="classes-cta reveal-up delay-4">
            <a href="#contacto" class="btn-primary btn-large">
              <span>Inscribirme Ahora</span>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </a>
            <div class="classes-price-note">
              <span class="price-from">Desde</span>
              <span class="price-amount">$140,000</span>
              <span class="price-period">/ mes</span>
            </div>
          </div>
        </div>

        <div class="classes-image reveal-right">
          <div class="img-frame">
            <img
              src="/music_class.png"
              alt="Clases de música en Universo Musical"
              width="600"
              height="500"
              loading="lazy"
            />
            <div class="img-badge">
              <span>⭐ 4.9/5</span>
              <span>Calificación de instructores</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== EVENTOS ========== -->
  <section class="events-section" id="eventos">
    <div class="events-bg">
      <img src="/sound_event.png" alt="Eventos sonoros — Asesoría de sonido profesional" class="events-bg-img" width="1920" height="1080" loading="lazy" />
      <div class="events-overlay"></div>
    </div>
    <div class="container">
      <div class="events-content">
        <p class="section-eyebrow reveal-up light-eyebrow">
          Producción & Sonido
        </p>
        <h2 class="section-title reveal-up delay-1 light-title">
          Asesoría para <br /><span class="gradient-text">Eventos Sonoros</span>
        </h2>
        <p
          class="section-desc reveal-up delay-2 light-desc"
          style="color: rgba(255,255,255,0.8);"
        >
          Diseñamos y ejecutamos sistemas de sonido de alta fidelidad para todo
          tipo de eventos. Nuestro equipo técnico garantiza una experiencia
          auditiva inigualable.
        </p>

        <div class="events-features reveal-up delay-3">
          <div class="event-feat" id="ef-concert">
            <div class="ef-icon">🎪</div>
            <div class="ef-text">
              <strong>Conciertos & Festivales</strong>
              <span>Sistemas line array, monitors, backline</span>
            </div>
          </div>
          <div class="event-feat" id="ef-corporate">
            <div class="ef-icon">🏢</div>
            <div class="ef-text">
              <strong>Eventos Corporativos</strong>
              <span>Conferencias, lanzamientos, premiaciones</span>
            </div>
          </div>
          <div class="event-feat" id="ef-wedding">
            <div class="ef-icon">💒</div>
            <div class="ef-text">
              <strong>Bodas & Celebraciones</strong>
              <span>Ambientación perfecta para cada momento</span>
            </div>
          </div>
          <div class="event-feat" id="ef-theater">
            <div class="ef-icon">🎭</div>
            <div class="ef-text">
              <strong>Teatro & Artes</strong>
              <span>Diseño de sonido para producciones artísticas</span>
            </div>
          </div>
        </div>

        <a href="#contacto" class="btn-primary btn-large reveal-up delay-4">
          <span>Solicitar Cotización</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- ========== TESTIMONIOS ========== -->
  <section class="testimonials-section" id="testimonios">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow reveal-up">Lo Dicen Ellos</p>
        <h2 class="section-title reveal-up delay-1">
          Músicos que nos <span class="gradient-text">Eligen</span>
        </h2>
      </div>

      <div class="testimonials-wrapper">
        <div class="testimonials-progress" id="testimonialsProgress"><div class="tp-bar"></div></div>
        <div class="testimonials-track" id="testimonialsTrack">
          <div class="testimonial-card" id="t1">
            <div class="t-quote">"</div>
            <p class="t-text">
              Universo Musical cambió mi vida musical. Encontré mi guitarra
              perfecta y las clases de jazz que me llevaron a mi primer
              concierto profesional.
            </p>
            <div class="t-author">
              <div class="t-avatar">🧑‍🎤</div>
              <div class="t-info">
                <strong>Carlos Medina</strong>
                <span>Guitarrista Profesional</span>
              </div>
              <div class="t-stars">⭐⭐⭐⭐⭐</div>
            </div>
          </div>

          <div class="testimonial-card" id="t2">
            <div class="t-quote">"</div>
            <p class="t-text">
              El equipo de asesoría para eventos fue increíble. El sonido de
              nuestra boda fue perfecto, todos los invitados quedaron
              maravillados.
            </p>
            <div class="t-author">
              <div class="t-avatar">👩</div>
              <div class="t-info">
                <strong>Laura Vélez</strong>
                <span>Clienta de Eventos</span>
              </div>
