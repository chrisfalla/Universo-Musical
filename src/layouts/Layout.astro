---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "Universo Musical — Tienda de Música & Arte Sonoro",
  description = "Universo Musical: Tu destino definitivo para instrumentos musicales, clases, accesorios, sonidos digitales y asesoría para eventos. Donde la música cobra vida.",
  image = "/og-image.png",
  canonical
} = Astro.props;

const BASE_URL = "https://universomusicalneiva.com";
const url = Astro.url;
const canonicalUrl = canonical
  ? `${BASE_URL}${canonical}`
  : `${BASE_URL}${url.pathname}`;
const ogImage = `${BASE_URL}${image}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={canonicalUrl} />
  <link rel="alternate" hreflang="es-CO" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Universo Musical" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={description} />
  <meta property="og:locale" content="es_CO" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Theme Color -->
  <meta name="theme-color" content="#1A3A6C" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Structured Data -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Universo Musical",
  "image": "https://universomusicalneiva.com/og-image.png",
  "url": "https://universomusicalneiva.com",
  "telephone": "+57 302 822 5644",
  "email": "jhones.1.9@hotmail.com",
  "priceRange": "$ - $$$",
  "currenciesAccepted": "COP",
  "paymentAccepted": ["Efectivo", "Tarjeta de Crédito", "PSE", "Nequi"],
  "foundingDate": "2024",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Carrera 32 E # 22A sur - 61 Barrio Encenillo",
    "addressLocality": "Neiva",
    "addressRegion": "Huila",
    "addressCountry": "CO"
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Neiva"
    },
    {
      "@type": "State",
      "name": "Huila"
    },
    {
      "@type": "Country",
      "name": "Colombia"
    }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:30",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "10:00",
      "closes": "17:00"
    }
  ],
  "sameAs": [
    "https://www.instagram.com/universomusical_neiva/",
    "https://web.facebook.com/UniversoMusicalNeiva"
  ],
  "description": "Universo Musical: Tienda de instrumentos musicales, clases, accesorios, sonidos digitales y asesoría para eventos en Neiva, Huila."
}
</script>
</head>
<body>

  <!-- ========== CURSOR PERSONALIZADO ========== -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-follower" id="cursorFollower"></div>

  <!-- ========== PRELOADER ========== -->
  <div class="preloader" id="preloader">
    <div class="preloader-inner">
      <div class="preloader-logo">UNIVERSO MUSICAL</div>
      <div class="preloader-bar"><div class="preloader-progress" id="preloaderProgress"></div></div>
      <div class="preloader-note">♪ Cargando el universo musical...</div>
    </div>
  </div>

  <!-- ========== PARTÍCULAS DE FONDO ========== -->
  <canvas class="particles-canvas" id="particlesCanvas"></canvas>

  <slot />

  <noscript>
    <div class="noscript-fallback">
      <div class="noscript-icon">🎵</div>
      <h2 class="noscript-title">Universo Musical</h2>
      <p class="noscript-text">Habilita JavaScript para disfrutar de la experiencia completa.</p>
    </div>
    <style>.preloader,.particles-canvas,.cursor,.cursor-follower{display:none!important}.noscript-fallback{position:fixed;inset:0;background:#0A0A0A;z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;padding:32px;text-align:center}.noscript-icon{font-size:48px}.noscript-title{font-family:'Bebas Neue',sans-serif;color:#D4AF37;font-size:2rem;letter-spacing:0.05em}.noscript-text{color:rgba(255,255,255,0.6);font-size:1rem;max-width:400px;line-height:1.6}</style>
  </noscript>

  <script src="../scripts/main.js"></script>
</body>
</html>
